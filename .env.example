DATABASE_URL=postgres://videocraft:change-me@localhost:5432/videocraft
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_JWT_SECRET_PREVIOUS=replace-during-overlap-rotation
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=
SECRET_PROVIDER=env
SECRET_MANAGER_SECRET_ID=
AWS_REGION=us-east-1
AUTH_AUDIENCE=
MEDIA_ROOT=./data/media
RENDER_ROOT=./data/renders
RENDER_WORK_ROOT=./data/render-work
WHISPER_WORKER_PATH=./workers/transcription/worker.py
WHISPER_PYTHON=python
WHISPER_LANGUAGE=
SCENE_WORKER_PATH=./workers/scene-detection/worker.py
SCENE_PYTHON=python
OBJECT_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false
INTENT_PROVIDER_URL=https://api.openai.com/v1
INTENT_PROVIDER_MODE=rule-based
INTENT_PROVIDER_URL=https://api.openai.com/v1
INTENT_PROVIDER_MODEL=gpt-4o-mini
INTENT_PROVIDER_API_KEY=
INTENT_PROVIDER_MODEL=gpt-4o-mini
INTENT_PROVIDER_MAX_PER_MINUTE=20
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=videocraft-api
PORT=8080

# Retention worker (dry-run by default; cutoff is mandatory when invoked)
RETENTION_CUTOFF=
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_MS=0
RETENTION_MAX_DELETES=100
RETENTION_PREFIX=

# Backup verification worker (requires a PostgreSQL custom-format dump and pg_restore)
BACKUP_STORAGE_KEY=
BACKUP_EXPECTED_SHA256=
BACKUP_EXPECTED_SIZE_BYTES=
PG_RESTORE_BIN=pg_restore
